#!/bin/sh
set -e

. /usr/share/debconf/confmodule

# Nothing to ask once instances exist; they are managed with tapir-instance
if ls /etc/tapir/instances/*.env >/dev/null 2>&1; then
    exit 0
fi

db_input high tapir/create_instance || true
db_go || true
db_get tapir/create_instance
[ "$RET" = true ] || exit 0

# The name is also used for the database, the containers and the realm: a-z, 0-9 and -
while :; do
    db_input high tapir/instance_name || true
    db_go || true
    db_get tapir/instance_name
    name="$(printf '%s' "$RET" | tr 'A-Z_' 'a-z-')"
    db_set tapir/instance_name "$name"
    if printf '%s' "$name" | grep -qE '^[a-z][a-z0-9-]{1,30}$'; then break; fi
    db_fset tapir/instance_name seen false
done
db_input high tapir/domain || true
db_input high tapir/port || true
db_input high tapir/admin_email || true
db_input medium tapir/image || true
db_go || true
