#: tapir/bidding_round/services/contract_creator.py:53
msgid "Contracts can only be created after the bidding round has ended."
msgstr "Verträge können erst nach Abschluss der Beitragsrunde erzeugt werden."

#: tapir/bidding_round/services/contract_creator.py:58
msgid "The average bid must be locked before contracts can be created."
msgstr "Das Durchschnittsgebot muss gesperrt werden, bevor Verträge erzeugt werden können."

#: tapir/bidding_round/services/contract_creator.py:70
#, python-format
msgid ""
"All selected bids must be confirmed before contracts can be created. Still "
"unconfirmed: %(names)s"
msgstr "Alle ausgewählten Gebote müssen bestätigt werden, bevor Verträge erzeugt werden können. Noch unbestätigt: %(names)s"

#: tapir/bidding_round/services/contract_deletion_service.py:27
msgid "No contracts have been created for this bidding round."
msgstr "Für diese Beitragsrunde wurden keine Verträge erzeugt."

