#: tapir/bidding_round/services/bid_validator.py:23
#: tapir/bidding_round/services/bid_validator.py:36
msgid "Please select at least one harvest share."
msgstr "Bitte wähle mindestens einen Ernteanteil."

#: tapir/bidding_round/services/bid_validator.py:68
msgid "The bidding round is not active."
msgstr "Die Beitragsrunde ist nicht aktiv."

#: tapir/bidding_round/services/bid_validator.py:71
msgid "The bidding round has not started yet."
msgstr "Die Beitragsrunde hat noch nicht begonnen."

#: tapir/bidding_round/services/bid_validator.py:73
msgid "The bidding round has already ended."
msgstr "Die Beitragsrunde ist bereits beendet."

#: tapir/bidding_round/services/bid_validator.py:80
msgid "The amount must not be negative."
msgstr "Der Betrag darf nicht negativ sein."

#: tapir/bidding_round/services/bid_validator.py:88
msgid "The product does not belong to the biddable harvest share."
msgstr "Das Produkt gehört nicht zu dem bietbaren Ernteanteil."

#: tapir/bidding_round/services/bid_validator.py:95
msgid "The amount must not be below the minimum price."
msgstr "Der Betrag darf den Mindestpreis nicht unterschreiten."

#: tapir/bidding_round/services/bid_validator.py:98
msgid "The number of shares is invalid."
msgstr "Die Anzahl Anteile ist ungültig."

#: tapir/bidding_round/services/bid_validator.py:115
msgid "Please provide the yellow amount (satisfied)."
msgstr "Bitte gib den Gelb-Betrag (Zufrieden) an."

#: tapir/bidding_round/services/bid_validator.py:121
msgid "Please provide all bids."
msgstr "Bitte gib alle Gebote an."

#: tapir/bidding_round/services/bid_validator.py:124
msgid "Too many bids were provided."
msgstr "Es wurden zu viele Gebote angegeben."

#: tapir/bidding_round/services/bid_validator.py:129
msgid "The bids must be in ascending order."
msgstr "Die Gebote müssen aufsteigend sein."

#: tapir/bidding_round/services/bid_validator.py:151
msgid "Please select a pickup location."
msgstr "Bitte wähle einen Abholort."

#: tapir/bidding_round/services/bidding_round_capacity_service.py:66
#, python-format
msgid ""
"Insufficient capacity for the product types %(product_types)s and for the "
"pickup location %(pickup_locations)s."
msgstr "Nicht genügend Kapazität für die Produktarten %(product_types)s und für die Verteilstation %(pickup_locations)s."

#: tapir/bidding_round/services/bidding_round_capacity_service.py:74
#, python-format
msgid "Insufficient capacity for the product types %(product_types)s."
msgstr "Nicht genügend Kapazität für die Produktarten %(product_types)s."

#: tapir/bidding_round/services/bidding_round_capacity_service.py:77
#, python-format
msgid "Insufficient capacity for the pickup location %(pickup_locations)s."
msgstr "Nicht genügend Kapazität für die Verteilstation %(pickup_locations)s."

#: tapir/bidding_round/services/bidding_round_service.py:60
msgid "The bidding round must have an end date."
msgstr "Die Beitragsrunde muss ein Enddatum haben."

#: tapir/bidding_round/services/bidding_round_service.py:62
msgid "The start date must not be after the end date."
msgstr "Das Startdatum darf nicht nach dem Enddatum liegen."

#: tapir/bidding_round/services/bidding_round_service.py:74
msgid "Please select exactly one product type."
msgstr "Bitte genau einen Produkttyp auswählen."

#: tapir/bidding_round/services/bidding_round_service.py:101
msgid "Another bidding round is already active."
msgstr "Es ist bereits eine andere Beitragsrunde aktiv."

#: tapir/bidding_round/services/bidding_round_service.py:107
msgid "Only bidding rounds with status configuration can be started."
msgstr "Nur Beitragsrunden im Status Konfiguration können gestartet werden."

#: tapir/bidding_round/services/bidding_round_service.py:117
msgid "Only active bidding rounds can be closed."
msgstr "Nur aktive Beitragsrunden können beendet werden."

#: tapir/bidding_round/services/bidding_round_service.py:125
msgid "Only closed bidding rounds can be reopened."
msgstr "Nur abgeschlossene Beitragsrunden können wieder eröffnet werden."

#: tapir/bidding_round/services/bidding_round_service.py:146
msgid "The average bid is already locked."
msgstr "Das Durchschnittsgebot ist bereits gesperrt."

#: tapir/bidding_round/services/bidding_round_service.py:150
msgid "The surcharge must be between 0 and 100 percent."
msgstr "Der Aufschlag muss zwischen 0 und 100 Prozent liegen."

#: tapir/bidding_round/services/bidding_round_service.py:187
msgid "The average bid is not locked."
msgstr "Das Durchschnittsgebot ist nicht gesperrt."

#: tapir/bidding_round/services/bidding_round_service.py:191
msgid ""
"The average bid can no longer be unlocked once contracts have been created. "
"Delete the contracts first."
msgstr "Das Durchschnittsgebot kann nicht mehr entsperrt werden, sobald Verträge erzeugt wurden. Löschen Sie zuerst die Verträge."

#: tapir/bidding_round/services/bidding_round_service.py:213
msgid "Bidding rounds can only be deleted with status configuration or closed."
msgstr "Beitragsrunden können nur im Status Konfiguration oder Abgeschlossen gelöscht werden."

#: tapir/bidding_round/services/bidding_round_service.py:247
msgid ""
"The bidding procedure, contribution mode, number of bids and biddable "
"product types can only be changed as long as no bids have been placed."
msgstr "Bietverfahren, Beitragsmodus, Anzahl Gebote und bietbare Produkttypen können nur geändert werden, solange noch keine Gebote abgegeben wurden."

#: tapir/bidding_round/services/bidding_round_service.py:334
msgid "Only members can place a bid."
msgstr "Nur Mitglieder können ein Gebot abgeben."

#: tapir/bidding_round/services/bidding_round_view_service.py:47
#: tapir/bidding_round/templates/bidding_round/bidding_round.html:10
#: tapir/bidding_round/tests/services/test_bidding_round_view_service.py:35
msgid "Bidding round"
