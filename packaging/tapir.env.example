# Tapir configuration. Read by the tapir-* systemd units and by tapir-manage.
# After changing it: systemctl restart tapir.target

SECRET_KEY=@SECRET_KEY@
DEBUG=False
ALLOWED_HOSTS=tapir.example.org
SITE_URL=https://tapir.example.org

DATABASE_CONNECTION=postgresql://tapir:CHANGE_ME@localhost:5432/tapir
CELERY_BROKER_URL=redis://localhost:6379
CELERY_RESULT_BACKEND=redis://localhost:6379

KEYCLOAK_ADMIN_SERVER_URL=http://localhost:8080
KEYCLOAK_PUBLIC_URL=https://login.example.org
KEYCLOAK_CLIENT_ID=tapir-backend
KEYCLOAK_REALM_NAME=tapir
#KEYCLOAK_ADMIN_CLIENT_SECRET_KEY=
#KEYCLOAK_SKIP_VERIFICATION_EMAIL=False

# EMAIL_ENV=prod requires the EMAIL_HOST* settings below
EMAIL_ENV=dev
#EMAIL_HOST=
#EMAIL_HOST_SENDER=
#EMAIL_HOST_SENDER_NAME=
#EMAIL_HOST_USER=
#EMAIL_HOST_PASSWORD=
#SERVER_EMAIL=
#EMAIL_ADDRESS_ERRORS=

#MAILING_LISTS_ENABLED=False
#MAILMAN_URL=http://localhost:8001/3.1/
#MAILMAN_ADMIN_USER=restadmin
#MAILMAN_ADMIN_PASSWORD=

ERROR_LOG_DIR=/var/log/tapir

# Bind address of the gunicorn web server; put a reverse proxy (nginx, caddy) in front
GUNICORN_BIND=127.0.0.1:8000
GUNICORN_WORKERS=3

# Run "manage.py migrate" automatically when the package is upgraded
TAPIR_MIGRATE_ON_UPGRADE=true
