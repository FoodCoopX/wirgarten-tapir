# Production image of Tapir: one image for the web server (gunicorn), the celery worker and
# celery beat. Build from the repository root:
#   podman build -f docker/production/Containerfile --build-arg TAPIR_VERSION=$(git describe --always) -t tapir .
# Configuration comes from environment variables (see packaging/tapir.env.example), writable
# state lives in /data (media, uploads, mails, error logs, celery beat schedule).

FROM docker.io/library/node:24-slim AS frontend
WORKDIR /src
RUN corepack enable
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.json tsconfig.app.json tsconfig.node.json vite.config.ts ./
RUN CI=true pnpm install --frozen-lockfile
COPY src_frontend src_frontend
COPY tapir/core/static tapir/core/static
RUN pnpm run build

FROM docker.io/library/python:3.14-slim-trixie AS build
ARG POETRY_VERSION=2.5.1
RUN apt-get update -qq && apt-get install -y -qq --no-install-recommends gettext >/dev/null \
    && rm -rf /var/lib/apt/lists/*
COPY --from=ghcr.io/astral-sh/uv:0.9.2 /uv /uvx /usr/local/bin/
ENV UV_NO_CACHE=1 UV_PYTHON_DOWNLOADS=never
WORKDIR /app
COPY pyproject.toml poetry.lock ./
RUN uvx --from "poetry==$POETRY_VERSION" --with poetry-plugin-export \
        poetry export --format requirements.txt --extras bakery --output /tmp/requirements.txt \
    && uv venv /venv && uv pip install --python /venv/bin/python --require-hashes -r /tmp/requirements.txt
COPY manage.py ./
COPY tapir tapir
COPY --from=frontend /src/dist dist
RUN /venv/bin/python manage.py compilemessages -v 0 \
    && SECRET_KEY=build /venv/bin/python manage.py collectstatic --noinput -v 0 \
    && find /app -name __pycache__ -prune -exec rm -rf {} + \
    && /venv/bin/python -m compileall -q -j 0 /app /venv || true

FROM docker.io/library/python:3.14-slim-trixie
ARG TAPIR_VERSION=dev
ARG MJML_VERSION=4.14.1
ENV TAPIR_VERSION=$TAPIR_VERSION \
    PYTHONUNBUFFERED=1 \
    PATH=/venv/bin:/opt/mjml/node_modules/.bin:$PATH \
    LANG=de_DE.UTF-8 \
    ERROR_LOG_DIR=/data/log
RUN apt-get update -qq && apt-get install -y -qq --no-install-recommends \
        fonts-dejavu-core libfontconfig1 libglib2.0-0t64 libharfbuzz-subset0 libpango-1.0-0 \
        libpangoft2-1.0-0 locales nodejs npm >/dev/null \
    && sed -i '/de_DE.UTF-8/s/^# //; /en_US.UTF-8/s/^# //' /etc/locale.gen && locale-gen >/dev/null \
    && npm install --no-audit --no-fund --prefix /opt/mjml "mjml@$MJML_VERSION" >/dev/null \
    && apt-get purge -y -qq npm >/dev/null && apt-get autoremove -y -qq >/dev/null \
    && rm -rf /var/lib/apt/lists/* /root/.npm \
    && groupadd --system --gid 10100 tapir \
    && useradd --system --uid 10100 --gid tapir --home-dir /data --no-create-home tapir
COPY --from=build /venv /venv
COPY --from=build /app /app
COPY docker/production/entrypoint.sh /usr/local/bin/tapir-entrypoint
# Writable state in the /data volume
RUN cd /app \
    && rm -rf tapir/media tapir/filepond_temp_uploads tapir/filepond_stored_uploads \
    && ln -s /data/media tapir/media \
    && ln -s /data/filepond_temp_uploads tapir/filepond_temp_uploads \
    && ln -s /data/filepond_stored_uploads tapir/filepond_stored_uploads \
    && ln -s /data/emails_from_celery emails_from_celery \
    && install -d -o tapir -g tapir /data
WORKDIR /app
USER tapir
VOLUME /data
EXPOSE 8000
ENTRYPOINT ["tapir-entrypoint"]
CMD ["web"]
