DJANGO_VITE_DEBUG=1
DEBUG=1
DATABASE_CONNECTION=postgresql://tapir:tapir@localhost:5432/tapir
CELERY_BROKER_URL=redis://localhost:6379
CELERY_RESULT_BACKEND=redis://localhost:6379
# Local Keycloak from docker-compose. For an external server set these to the
# real values; see docs/admins/keycloak.md.
KEYCLOAK_ADMIN_SERVER_URL=http://localhost:8080
KEYCLOAK_PUBLIC_URL=http://localhost:8080
KEYCLOAK_REALM_NAME=tapir
KEYCLOAK_CLIENT_ID=tapir-backend
KEYCLOAK_FRONTEND_CLIENT_ID=tapir-frontend
KEYCLOAK_ADMIN_CLIENT_SECRET_KEY=**********
# Provisioning client created by docker/keycloak/import/tapir-realm.json.
# Change both the import and this secret together, then recreate the container.
KEYCLOAK_PROVISIONER_CLIENT_ID=tapir-provisioner
KEYCLOAK_PROVISIONER_CLIENT_SECRET_KEY=**********
KEYCLOAK_SKIP_VERIFICATION_EMAIL=1
SITE_URL=http://localhost:8000
EMAIL_ENV=prod
EMAIL_HOST=localhost
EMAIL_PORT=1025
EMAIL_USE_SSL=0
EMAIL_USE_TLS=0
EMAIL_HOST_SENDER=tapir@example.com
EMAIL_HOST_SENDER_NAME=Test Tapir
EMAIL_HOST_USER=test
EMAIL_HOST_PASSWORD=test
EMAIL_BOUNCE_ADDRESS=tapir@example.com
