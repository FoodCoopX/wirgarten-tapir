DJANGO_VITE_DEBUG=1
DEBUG=1
DATABASE_CONNECTION=postgresql://tapir:tapir@localhost:5432/tapir
CELERY_BROKER_URL=redis://localhost:6379
CELERY_RESULT_BACKEND=redis://localhost:6379
# Local Keycloak from docker-compose. For an external server set these to the
# real values; see docs/admins/keycloak.md.
KEYCLOAK_ADMIN_SERVER_URL=http://localhost:8080
KEYCLOAK_PUBLIC_URL=http://localhost:8080
KEYCLOAK_REALM_NAME=tapir
KEYCLOAK_CLIENT_ID=tapir-backend
KEYCLOAK_FRONTEND_CLIENT_ID=tapir-frontend
KEYCLOAK_ADMIN_CLIENT_SECRET_KEY=**********
# Provisioning client created by docker/keycloak/import/tapir-realm.json.
# Change both the import and this secret together, then recreate the container.
KEYCLOAK_PROVISIONER_CLIENT_ID=tapir-provisioner
KEYCLOAK_PROVISIONER_CLIENT_SECRET_KEY=**********
KEYCLOAK_SKIP_VERIFICATION_EMAIL=1
# Keycloak usernames for newly created users: email (default) or customernumber.
# KEYCLOAK_USERNAME_SOURCE=customernumber
# KEYCLOAK_USERNAME_FORMAT=raw   # raw (17) or formatted (BT0017)
# Optional realm/group overrides for `manage.py keycloak check|sync`.
# Set both username flags to 0 when usernames are customernumbers.
KEYCLOAK_REGISTRATION_EMAIL_AS_USERNAME=1
KEYCLOAK_EDIT_USERNAME_ALLOWED=0
KEYCLOAK_VERIFY_EMAIL=1
KEYCLOAK_SUPERUSER_GROUP_NAME=superuser
# Declarative user profile management (opt-in). The JSON file is the only profile source.
# KEYCLOAK_USER_PROFILE_MANAGED=1
# KEYCLOAK_USER_PROFILE_FILE=examples/keycloak-userprofile.json
# JSON list of {"keycloak": ..., "tapir": ...}; every keycloak name must exist in the profile file.
# KEYCLOAK_USER_PROFILE_ATTRIBUTE_MAP=[{"keycloak": "customernumber", "tapir": "member_no"}]
SITE_URL=http://localhost:8000
EMAIL_ENV=prod
EMAIL_HOST=localhost
EMAIL_PORT=1025
EMAIL_USE_SSL=0
EMAIL_USE_TLS=0
EMAIL_HOST_SENDER=tapir@example.com
EMAIL_HOST_SENDER_NAME=Test Tapir
EMAIL_HOST_USER=test
EMAIL_HOST_PASSWORD=test
EMAIL_BOUNCE_ADDRESS=tapir@example.com
